# trial
# grandparent class
class campusDirector:
  def __init__(self, CDname):
    self.CDname = CDname

  def set_CDname(self, CDname):
    self.CDname = CDname

  def get_CDname(self):
    return self.CDname

# parent class
class studentService(campusDirector):
  def __init__(self, CDname, dorm):
    super().__init__(CDname)
    self.dorm = dorm

  def set_dorm(self, dorm):
    self.dorm = dorm

  def get_dorm(self):
    return self.dorm

# parent class
class curriculumDep(campusDirector):
  def __init__(self, CDname, location, gradeLVL, budget):
    super().__init__(CDname)
    self.location = location
    self.gradeLVL = gradeLVL
    self.budget = budget

  def set_budget(self, budget):
    if budget > 0:
      self.budget = budget
    else:
      print("ERROR: The budget must be more than zero.")

  def get_budget(self):
    return self.budget

# kid class
class elementary(curriculumDep):
  def __init__(self, CDname, location, gradeLVL, budget, studentCount):
    super().__init__(CDname, location, gradeLVL, budget)
    self.studentCount = studentCount

  def get_studentCount(self):
    return self.studentCount

# kid class
