# act 1
class Animal:
    def __init__(self, name):
        self.__name = name
    def get_name(self):
        return self.__name
    def eat(self):
        pass
    def make_sound(self):
        pass
 
class Lion(Animal):
    def make_sound(self):
        print(f"{self.get_name()} roars loudly!")

    def eat(self):
        print(f"{self.get_name()} eats fresh meat.")

class Elephant(Animal):
    def make_sound(self):
        print(f"{self.get_name()} trumpets!")

    def eat(self):
        print(f"{self.get_name()} eats grass and fruits.")

class Monkey(Animal):
    def make_sound(self):
        print(f"{self.get_name()} chatters!")

    def eat(self):
        print(f"{self.get_name()} eats bananas.")

lion = Lion("Simba")
elephant = Elephant("Dumbo")
monkey = Monkey("George")

animals = [lion, elephant, monkey]

for animal in animals:
    animal.make_sound()
    animal.eat()
    print("-----")